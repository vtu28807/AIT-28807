graph = {
    'n': ['b', 'c'],
    's': ['n', 'o'],
    'o': ['n', 's'],
    'b': ['n', 's', 'c', 'e'],
    'c': ['n', 'b'],
    'e': ['b']
}

vertices = list(graph.keys())


def is_safe(vertex, color, colors):
    for neighbor in graph[vertex]:
        if colors.get(neighbor) == color:
            return False
    return True


def graph_coloring(index, max_colors, colors):
    # All vertices are colored
    if index == len(vertices):
        return True

    vertex = vertices[index]

    # Try every color
    for color in range(1, max_colors + 1):

        if is_safe(vertex, color, colors):
            colors[vertex] = color

            # Recursively color the next vertex
            if graph_coloring(index + 1, max_colors, colors):
                return True

            # Backtrack
            del colors[vertex]

    return False


max_colors = 2
colors = {}

if graph_coloring(0, max_colors, colors):

    print("Number of colors:", max(colors.values()))
    print("Vertex colors:")

    for vertex in vertices:
        print(vertex, "->", colors[vertex])

else:
    print("No valid coloring possible")
